# The icon tool's download cache: 223 upstream Open Iconic PNGs, the INPUT to
# tools/artwork/icon_cleaner.py. Regenerable with `--fetch`, and never shipped --
# what ships is the TGAs it writes into LibKa0s/media/icons/. This line came with
# the tool from MythicMeters, where it was learned the same way: a cache is not a
# payload, and a library repo has no business carrying 332KB of somebody else's
# source art.
tools/artwork/.cache/

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# VS Code
.vscode/

# Claude
.claude/
.claude/settings.local.json

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
